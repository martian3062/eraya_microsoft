# ─── Django ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=eraya.settings.development

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for dev — no setup needed)
DATABASE_URL=sqlite:///db.sqlite3
# Supabase Postgres (uncomment for production)
# DATABASE_URL=postgres://user:password@host:5432/eraya

# ─── Infrastructure ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ─── LLM providers ────────────────────────────────────────────────────────────
GROQ_API_KEY=
HUGGINGFACE_TOKEN=
HF_TOKEN=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ─── Agentic AI providers (caspr upgrade) - all OPTIONAL, graceful fallback ────
# LLM tier
KIMI_API_KEY=                  # Moonshot / Kimi - long-context planner
FEATHERLESS_API_KEY=           # serverless open-model catalog
SARVAM_API_KEY=                # Indic multilingual (optional)
# ML tier
TABPFN_API_KEY=                # TabPFN 3 - tabular risk scoring
# Memory
PINECONE_API_KEY=              # managed vector memory / RAG
CYBORGDB_API_KEY=              # encrypted vector memory
# Ingestion
FIRECRAWL_API_KEY=             # primary web ingestion (LLM-ready markdown)
BRIGHTDATA_API_KEY=            # anti-bot scraping fallback
ZENROWS_API_KEY=               # scraping API (optional)
TINYFISH_API_KEY=              # structured NL web extraction
# Orchestration
N8N_WEBHOOK_URL=               # n8n inbound webhook
N8N_API_KEY=                   # n8n REST API
# Dev / assets
ZERVE_API_KEY=                 # model + strategy backtesting
STITCH_API_KEY=                # UI generation
PEXELS_API_KEY=                # media / imagery

# ─── Eraya agent config ───────────────────────────────────────────────────────
A2A_BUS_BACKEND=redis          # redis | nats | websocket
ERAYA_X402_ENABLED=True        # add Casper x402 payment proofs to priced A2A messages
ML_DEVICE=cpu                  # cpu | cuda
ENABLE_GUARDIAN=True
LATENCY_BUDGET_MS=500

# ─── Security ─────────────────────────────────────────────────────────────────
# KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_REALM=eraya
# KEYCLOAK_CLIENT_ID=eraya-backend
# KEYCLOAK_CLIENT_SECRET=...

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Casper / Agentic Buildathon
CASPER_NETWORK=testnet
CSPR_CLOUD_REST_URL=
CASPER_MCP_URL=
CSPR_TRADE_MCP_URL=
CSPR_CLICK_API_URL=
X402_SETTLEMENT_MODE=demo
