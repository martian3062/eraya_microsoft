# ─── Django ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=eraya.settings.development

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for dev — no setup needed)
DATABASE_URL=sqlite:///db.sqlite3
# Supabase Postgres (uncomment for production)
# DATABASE_URL=postgres://user:password@host:5432/eraya

# ─── Infrastructure ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ─── LLM providers ────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_key_here
HUGGINGFACE_TOKEN=hf_your_token_here
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ─── Eraya agent config ───────────────────────────────────────────────────────
A2A_BUS_BACKEND=redis          # redis | nats | websocket
ML_DEVICE=cpu                  # cpu | cuda
ENABLE_GUARDIAN=True
LATENCY_BUDGET_MS=500

# ─── Security ─────────────────────────────────────────────────────────────────
# KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_REALM=eraya
# KEYCLOAK_CLIENT_ID=eraya-backend
# KEYCLOAK_CLIENT_SECRET=...

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
