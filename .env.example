# ─── Django ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=eraya.settings.development

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for dev — no setup needed)
DATABASE_URL=sqlite:///db.sqlite3
# Supabase Postgres (uncomment for production)
# DATABASE_URL=postgres://user:password@host:5432/eraya

# ─── Infrastructure ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ─── LLM providers ────────────────────────────────────────────────────────────
GROQ_API_KEY=
HUGGINGFACE_TOKEN=
HF_TOKEN=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ─── Agentic AI providers (caspr upgrade) - all OPTIONAL, graceful fallback ────
# LLM tier
KIMI_API_KEY=                  # Moonshot / Kimi - long-context planner
HF_LOCAL_LLM_ENABLED=false     # optional open-source local HF fallback
HF_LOCAL_LLM_MODEL=flan-t5-small
SARVAM_API_KEY=                # Indic multilingual (optional)
# ML tier
TABPFN_API_KEY=                # TabPFN 3 - tabular risk scoring
# Memory
PINECONE_API_KEY=              # managed vector memory / RAG
PINECONE_INDEX=eraya
PINECONE_DIMENSION=384
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
CYBORGDB_API_KEY=              # encrypted vector memory
# Ingestion
FIRECRAWL_API_KEY=             # primary web ingestion (LLM-ready markdown)
BRIGHTDATA_API_KEY=            # anti-bot scraping fallback
ZENROWS_API_KEY=               # scraping API (optional)
TINYFISH_API_KEY=              # structured NL web extraction
# Orchestration
N8N_WEBHOOK_URL=               # n8n inbound webhook
N8N_API_KEY=                   # n8n REST API
# Dev / assets
ZERVE_API_KEY=                 # model + strategy backtesting
STITCH_API_KEY=                # UI generation
PEXELS_API_KEY=                # media / imagery

# ─── Eraya agent config ───────────────────────────────────────────────────────
A2A_BUS_BACKEND=redis          # redis | nats | websocket
ERAYA_X402_ENABLED=True        # add Casper x402 payment proofs to priced A2A messages
ML_DEVICE=cpu                  # cpu | cuda
ENABLE_GUARDIAN=True
LATENCY_BUDGET_MS=500

# ─── Security ─────────────────────────────────────────────────────────────────
# KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_REALM=eraya
# KEYCLOAK_CLIENT_ID=eraya-backend
# KEYCLOAK_CLIENT_SECRET=...

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Casper / Agentic Buildathon
CASPER_NETWORK=testnet
CSPR_CLOUD_REST_URL=              # CSPR.cloud REST base (present => live chain data)
CSPR_CLOUD_API_KEY=              # CSPR.cloud auth key
CASPER_MCP_URL=
CSPR_TRADE_MCP_URL=
CSPR_CLICK_API_URL=
X402_SETTLEMENT_MODE=demo

# ─── On-chain anomaly anchoring + signing (Part B) ─────────────────────────────
# Set all three to enable REAL testnet transactions (else demo no-op).
CASPER_NODE_RPC_URL=             # testnet node RPC, e.g. http://<node>:7777/rpc
CASPER_SECRET_KEY_PATH=         # path to funded secret_key.pem on the VM
CASPER_CHAIN_NAME=casper-test
CASPER_CLIENT_BIN=casper-client  # override if not on PATH
CASPER_PUBLIC_KEY=0202f47d42c6d9b836fe93777489699ae33f12a924a8f2520ace7bb84226a2e4bf69
CASPER_ACCOUNT_HASH=cbd9021f24d2c5c494a8f6fd645b151dc09d69671b3ca9ffc866396be0b7e77f
CASPER_ANOMALY_CONTRACT=        # set after deploying the AnomalyAnchor contract

# ─── x402 agent-economy payments ──────────────────────────────────────────────
X402_PRICE_MOTES=1000000        # default price per paid resource (0.001 CSPR)
